# Mandatory

TELEGRAM_BOT_TOKEN=your_telegram_bot_token # Telegram bot token from @BotFather for alerts and interactive cards
TELEGRAM_CHAT_ID=your_telegram_chat_id # Your personal Telegram chat ID from @userinfobot to authorize access
TELEGRAM_ALLOWED_USER_IDS=your_telegram_chat_id # Authorized user or chat IDs (comma-separated for multiple users)
TELEGRAM_BOT_USERNAME=your_bot_username # Telegram bot username (e.g. MyJobSearchBot)
GEMINI_API_KEY=your_gemini_api_key # Google Gemini API key from https://aistudio.google.com/ for scoring and tailoring
LLM_PROVIDER=gemini # Active AI provider: gemini (default), openai, claude, groq, deepseek, openrouter, ollama
N8N_ENCRYPTION_KEY=your_32_char_encryption_key # 32-character key used by n8n to encrypt credentials in its database
N8N_PORT=5678 # Local HTTP port for n8n web dashboard (default: 5678)
N8N_HOST_BINDING=127.0.0.1 # IP address binding for n8n (127.0.0.1 limits access strictly to localhost)
N8N_WORKFLOW_ID=master-bot # Workflow identifier inside n8n database
N8N_BASIC_AUTH_ACTIVE=false # Enable basic authentication on n8n web dashboard
N8N_BASIC_AUTH_USER=your_email@domain.com # Username for n8n basic authentication
N8N_BASIC_AUTH_PASSWORD=your_n8n_password # Password for n8n basic authentication
ADZUNA_APP_ID=your_adzuna_app_id # Adzuna Job Board API App ID from https://developer.adzuna.com/
ADZUNA_APP_KEY=your_adzuna_app_key # Adzuna Job Board API Key from https://developer.adzuna.com/
USAJOBS_API_KEY= # USAJOBS Federal API key from https://developer.usajobs.gov/
SMTP_HOST=smtp.gmail.com # Outbound SMTP email server host
SMTP_PORT=465 # Outbound SMTP email server port
SMTP_USER=your_email@gmail.com # Outbound SMTP email sender address
SMTP_PASSWORD=your_smtp_app_password # Outbound SMTP email application password
DATA_DIR=./data # Directory path for candidate profile, settings, and job tracking databases
SCRIPTS_DIR=./scripts # Directory path for core helper and engine scripts
PROMPTS_DIR=./prompts # Directory path for prompt templates and schemas
WORKFLOWS_DIR=./workflows # Directory path for n8n workflow JSON definitions
TELEGRAM_WEBHOOK_PATH=telegram-callback # Webhook path suffix for Telegram interaction callback
TELEGRAM_WEBHOOK_ID=e6a4b123-5e6f-7a8b-9c0d-1e2f3a4b5c6d # Unique webhook UUID in n8n database

# Optional

NODE_ENV=local # Execution environment mode
ADZUNA_COUNTRY=ca # Adzuna target country code (auto-derived from master-profile.json if omitted: ca, us, gb, etc.)
MIN_SCORE_THRESHOLD=60 # Minimum match score (0-100) required to push Telegram alert card (default: 60)
MAX_UPLOAD_SIZE_MB=5 # Maximum allowed resume upload size in Megabytes (default: 5)
TIMEZONE=America/Toronto # Scheduler timezone (automatically detected from master-profile.json if omitted)
ADZUNA_SEARCH_ROLE=Data Analyst # Fallback search title if master-profile.json is not yet created
ADZUNA_SEARCH_LOCATION=Toronto # Fallback search location if master-profile.json is not yet created
# Google Serper API key for automated recruiter Google search from https://google.serper.dev/
SERPER_API_KEY=
# Hunter.io API key for recruiter email address discovery from https://hunter.io/
HUNTER_API_KEY=
# Specific model override (leave blank to use the built-in 10-model waterfall)
LLM_MODEL=
# OpenAI API key (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Claude API key (required only if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
# Groq API key (required only if LLM_PROVIDER=groq)
GROQ_API_KEY=
# DeepSeek API key (required only if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
# OpenRouter API key (required only if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Public URL if running on a VPS with custom domain (leave blank for local polling)
WEBHOOK_URL=
# Cloudflare Zero Trust Named Tunnel token (leave blank for local polling)
CLOUDFLARE_TUNNEL_TOKEN=
USAJOBS_EMAIL=your_email@example.com # Contact email passed in USAJOBS User-Agent header (required by USAJobs API)
USAJOBS_USER_AGENT=JobRyt-AI-Bot/1.0 # Custom User-Agent header for USAJOBS API requests
N8N_URL=http://localhost:5678 # Base URL for n8n API calls (e.g. from telegram bridge or scripts)
# Custom SQLite database path (default: /home/node/.n8n/database.sqlite inside container)
N8N_DB_PATH=
