# ==============================================================================
# Mandatory Configuration
# ==============================================================================

# Telegram bot token from @BotFather for alerts and interactive cards
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your personal Telegram chat ID from @userinfobot to authorize access
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Authorized user or chat IDs (comma-separated for multiple users)
TELEGRAM_ALLOWED_USER_IDS=your_telegram_chat_id

# Telegram bot username (e.g. MyJobSearchBot)
TELEGRAM_BOT_USERNAME=your_bot_username

# Google Gemini API key from https://aistudio.google.com/ for scoring and tailoring
GEMINI_API_KEY=your_gemini_api_key

# Active AI provider: gemini (default), openai, claude, groq, deepseek, openrouter, ollama
LLM_PROVIDER=gemini

# 32-character key used by n8n to encrypt credentials in its database
N8N_ENCRYPTION_KEY=your_32_char_encryption_key

# Local HTTP port for n8n web dashboard (default: 5678)
N8N_PORT=5678

# IP address binding for n8n (127.0.0.1 limits access strictly to localhost)
N8N_HOST_BINDING=127.0.0.1

# Workflow identifier inside n8n database
N8N_WORKFLOW_ID=master-bot

# Enable basic authentication on n8n web dashboard
N8N_BASIC_AUTH_ACTIVE=false

# Username for n8n basic authentication
N8N_BASIC_AUTH_USER=your_email@domain.com

# Password for n8n basic authentication
N8N_BASIC_AUTH_PASSWORD=your_n8n_password

# Adzuna Job Board API App ID from https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id

# Adzuna Job Board API Key from https://developer.adzuna.com/
ADZUNA_APP_KEY=your_adzuna_app_key

# USAJOBS Federal API key from https://developer.usajobs.gov/
USAJOBS_API_KEY=your_usajobs_api_key

# Outbound SMTP email server host
SMTP_HOST=smtp.gmail.com

# Outbound SMTP email server port
SMTP_PORT=465

# Outbound SMTP email sender address
SMTP_USER=your_email@gmail.com

# Outbound SMTP email application password
SMTP_PASSWORD=your_smtp_app_password

# Directory path for candidate profile, settings, and job tracking databases
DATA_DIR=./data

# Directory path for core helper and engine scripts
SCRIPTS_DIR=./scripts

# Directory path for prompt templates and schemas
PROMPTS_DIR=./prompts

# Directory path for n8n workflow JSON definitions
WORKFLOWS_DIR=./workflows

# Webhook path suffix for Telegram interaction callback
TELEGRAM_WEBHOOK_PATH=telegram-callback

# Unique webhook UUID in n8n database
TELEGRAM_WEBHOOK_ID=e6a4b123-5e6f-7a8b-9c0d-1e2f3a4b5c6d

# ==============================================================================
# Optional Configuration
# ==============================================================================

# Adzuna target country code (auto-derived from master-profile.json if omitted: ca, us, gb, etc.)
ADZUNA_COUNTRY=ca

# Minimum match score (0-100) required to push Telegram alert card (default: 60)
MIN_SCORE_THRESHOLD=60

# Maximum allowed resume upload size in Megabytes (default: 5)
MAX_UPLOAD_SIZE_MB=5

# Scheduler timezone (automatically detected from master-profile.json if omitted)
TIMEZONE=America/Toronto

# Fallback search title if master-profile.json is not yet created
ADZUNA_SEARCH_ROLE=Data Analyst

# Fallback search location if master-profile.json is not yet created
ADZUNA_SEARCH_LOCATION=Toronto

# Google Serper API key for automated recruiter Google search from https://google.serper.dev/
SERPER_API_KEY=

# Hunter.io API key for recruiter email address discovery from https://hunter.io/
HUNTER_API_KEY=

# Specific model override (leave blank to use the built-in 10-model waterfall)
LLM_MODEL=

# OpenAI API key (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI API base URL endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API key (required only if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Groq API key (required only if LLM_PROVIDER=groq)
GROQ_API_KEY=

# DeepSeek API key (required only if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# OpenRouter API key (required only if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama local server URL (required only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Public URL if running on a VPS with custom domain (leave blank for local polling)
WEBHOOK_URL=

# Cloudflare Zero Trust Named Tunnel token (leave blank for local polling)
CLOUDFLARE_TUNNEL_TOKEN=

# Contact email passed in USAJOBS User-Agent header (required by USAJobs API)
USAJOBS_EMAIL=your_email@example.com

# Custom User-Agent header for USAJOBS API requests
USAJOBS_USER_AGENT=JobRyt-AI-Bot/1.0

# Base URL for n8n API calls (e.g. from telegram bridge or scripts)
N8N_URL=http://localhost:5678

# Custom SQLite database path (default: /home/node/.n8n/database.sqlite inside container)
N8N_DB_PATH=
